// Agregar producto con categoria y promocion
function agregarProducto(nombre, precio, cantidad, categoria, promocion) {
    let producto = {
        nombre: nombre,
        precio: precio,
        cantidad: cantidad,
        categoria: categoria,
        promocion: promocion
    };

    productos.push(producto);
    console.log("Producto agregado correctamente.");
}

// Mostrar productos de cocina
function listarProductos() {
    console.log("\n===== PRODUCTOS DE COCINA =====");

    if (productos.length == 0) {
        console.log("No hay productos.");
    } else {
        productos.forEach((producto, index) => {
            console.log(
                (index + 1) + ". " +
                producto.nombre +
                " - $" + producto.precio +
                " - Cantidad: " + producto.cantidad +
                " - Categoria: " + producto.categoria
            );
        });
    }
}

// Promesa para simular la preparacion en cocina
function prepararEnCocina(nombreProducto) {
    return new Promise((resolve, reject) => {
        // Simulacion de imprevistos según el nombre o condicion
        if (nombreProducto.toLowerCase().includes("cancelar")) {
            reject("Error en cocina");
        } else if (nombreProducto.toLowerCase().includes("agotado")) {
            reject("Falta ingrediente");
        } else {
            resolve("Pedido preparado con éxito");
        }
    });
}

// Búsquedas y filtros INTERACTIVOS desde la terminal (filter y find)
function busquedasFiltrosTerminal() {
    console.log(`
===== BUSQUEDAS Y FILTROS =====
1. Filtrar por Categoria
2. Filtrar por Precio Maximo
3. Buscar Producto por Nombre
`);

    rl.question("Selecciona el tipo de filtro: ", function(opcionFiltro) {
        if (opcionFiltro === "1") {
            rl.question("Ingresa la categoria a buscar (bebida/postre): ", function(cat) {
                // Uso de filter() dinamico
                let resultados = productos.filter(p => p.categoria.toLowerCase() === cat.toLowerCase().trim());
                
                console.log("\n-- RESULTADOS DE CATEGORIA: " + cat + " --");
                if (resultados.length === 0) {
                    console.log("No se encontraron productos en esa categoria.");
                } else {
                    resultados.forEach(p => console.log(p.nombre + " - $" + p.precio + " (Stock: " + p.cantidad + ")"));
                }
                preguntarContinuar();
            });

        } else if (opcionFiltro === "2") {
            rl.question("Ingresa el precio maximo: ", function(precioMax) {
                let limite = parseFloat(precioMax);
                // Uso de filter() dinamico
                let baratos = productos.filter(p => p.precio <= limite);

                console.log("\n-- PRODUCTOS HASTA $" + limite + " --");
                if (baratos.length === 0) {
                    console.log("No hay productos dentro de ese rango de precio.");
                } else {
                    baratos.forEach(p => console.log(p.nombre + " - $" + p.precio));
                }
                preguntarContinuar();
            });

        } else if (opcionFiltro === "3") {
            rl.question("Ingresa el nombre del producto a buscar: ", function(busqueda) {
                // Uso de find() dinamico
                let encontrado = productos.find(p => p.nombre.toLowerCase().includes(busqueda.toLowerCase().trim()));

                console.log("\n-- RESULTADO DE BUSQUEDA --");
                if (encontrado) {
                    console.log("Encontrado: " + encontrado.nombre + " - $" + encontrado.precio + " | Categoria: " + encontrado.categoria);
                } else {
                    console.log("Producto no encontrado.");
                }
                preguntarContinuar();
            });

        } else {
            console.log("Opcion invalida.");
            preguntarContinuar();
        }
    });
}

// Editar producto
function editarProducto(indice, nombre, precio, cantidad, categoria, promocion) {
    if (indice >= 0 && indice < productos.length) {
        productos[indice].nombre = nombre;
        productos[indice].precio = precio;
        productos[indice].cantidad = cantidad;
        productos[indice].categoria = categoria;
        productos[indice].promocion = promocion;

        console.log("Producto editado correctamente.");
    } else {
        console.log("Producto no encontrado.");
    }
}

// Eliminar producto
function eliminarProducto(indice) {
    if (indice >= 0 && indice < productos.length) {
        productos.splice(indice, 1);
        console.log("Producto eliminado correctamente.");
    } else {
        console.log("Producto no encontrado.");
    }
}


