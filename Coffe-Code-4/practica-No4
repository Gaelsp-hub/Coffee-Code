// Simular la trayectoria asincrona del pedido con setTimeout y Promesas
function seguimientoAsincronoPedido(nombreProducto, callbackCaja) {
    console.log("\n--- PROCESANDO PEDIDO ---");
    console.log("Estado: Pedido recibido");

    // Asincronia 1
    setTimeout(() => {
        console.log("Estado: Preparando........");

        // Asincronia 2
        setTimeout(() => {
            console.log("Estado: Empacando........");

            // Evaluacion con Promesa de Cocina
            setTimeout(() => {
                prepararEnCocina(nombreProducto)
                    .then((mensajeExito) => {
                        // Notificacion exitosa via Callback
                        callbackCaja(true, "Pedido Entregado (" + mensajeExito + ")");
                    })
                    .catch((mensajeError) => {
                        // Notificacion cancelada via Callback
                        callbackCaja(false, "Pedido Cancelado (" + mensajeError + ")");
                    });
            }, 1500);

        }, 1500);

    }, 1500);
}

// Crear pedido
function crearPedido(indice, cantidad) {
    if (indice >= 0 && indice < productos.length) {
        let producto = productos[indice];

        if (cantidad > 0 && cantidad <= producto.cantidad) {
            let pedido = {
                producto: producto.nombre,
                precio: producto.precio,
                cantidad: cantidad
            };

            pedidos.push(pedido);
            producto.cantidad = producto.cantidad - cantidad;

            console.log("\nProcesando orden...");
            
            // Inicia flujo asincrono enlazado con la Caja (Callback)
            seguimientoAsincronoPedido(producto.nombre, notificarCaja);

        } else {
            console.log("Cantidad no disponible.");
            preguntarContinuar();
        }
    } else {
        console.log("Producto no encontrado.");
        preguntarContinuar();
    }
}

// Listar pedidos del cliente
function listarPedidos() {
    console.log("\n===== MIS PEDIDOS =====");

    if (pedidos.length == 0) {
        console.log("No hay pedidos.");
    } else {
        pedidos.forEach((pedido, index) => {
            let total = pedido.precio * pedido.cantidad;
            console.log(
                (index + 1) + ". " +
                pedido.producto +
                " x" + pedido.cantidad +
                " - $" + total
            );
        });
    }
}


