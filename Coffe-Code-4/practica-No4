                        parseInt(cantidad)
                    );
                });
            });

        } else if (opcion == "4") {
            listarPedidos();
            preguntarContinuar();

        } else if (opcion == "5") {
            mostrarCaja();
            preguntarContinuar();

        } else if (opcion == "6") {
            busquedasFiltrosTerminal();

        } else if (opcion == "7") {
            rl.question("Nombre del producto: ", function(nombre) {
                rl.question("Precio: ", function(precio) {
                    rl.question("Cantidad: ", function(cantidad) {
