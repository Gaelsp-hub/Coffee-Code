            });

        } else if (opcion == "9") {
            listarProductos();

            rl.question("\nNumero del producto a eliminar: ", function(numero) {
                eliminarProducto(parseInt(numero) - 1);
                preguntarContinuar();
            });

        } else if (opcion == "10") {
            console.log("\nSaliendo del sistema...");
            rl.close();

        } else {
            console.log("Opcion incorrecta.");
            menu();
        }
    });
}


