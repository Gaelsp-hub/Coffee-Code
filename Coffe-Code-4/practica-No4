// Callback para recibir notificacion de estados desde Cliente/Cocina
function notificarCaja(exito, estadoFinal) {
    console.log("\n==================================");
    if (exito) {
        console.log("NOTIFICACION CAJA: ¡PEDIDO LISTO!");
        console.log("Detalle: " + estadoFinal);
    } else {
        console.log("NOTIFICACION CAJA: ¡PEDIDO CANCELADO!");
        console.log("Detalle: " + estadoFinal);
    }
    console.log("==================================");
    
    preguntarContinuar();
}

// Mostrar caja con subtotal, IVA y total con reduce y destructuring
function mostrarCaja() {
    console.log("\n===== CAJA =====");

    if (pedidos.length == 0) {
        console.log("No hay pedidos registradas.");
    } else {
        // Destructuring en el recorrido
        pedidos.forEach(({ producto, precio, cantidad }, index) => {
            let subtotalLinea = precio * cantidad;
            console.log(
                (index + 1) + ". " +
                producto +
                " (x" + cantidad + ") - $" + subtotalLinea
            );
        });

        // Calculo de total usando reduce y destructuring
        let subtotal = pedidos.reduce((acumulado, { precio, cantidad }) => {
            return acumulado + (precio * cantidad);
        }, 0);

        let iva = subtotal * 0.16;
        let total = subtotal + iva;

        console.log("----------------------------");
        console.log("Subtotal: $" + subtotal);
        console.log("IVA (16%): $" + iva);
        console.log("Total a pagar: $" + total);
    }
}


